# Copy this file to .env and fill in the values.
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.REGION.firebasedatabase.app
FIREBASE_CREDENTIALS=credentials/firebase-service-account.json
FLASK_SECRET_KEY=replace-with-a-long-random-string
# Neo4j (optional) - graph mirror of your data. Leave blank to disable.
NEO4J_URI=neo4j+s://YOUR-INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Set to 1 only on your own machine while developing.
FLASK_DEBUG=0
